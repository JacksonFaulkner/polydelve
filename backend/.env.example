# Copy to backend/.env. Only DATABASE_URL is needed to run the API and tests;
# the rest unlock ETL jobs and auth.

# Postgres (make dev starts this via backend/docker-compose.yml)
DATABASE_URL=postgresql://polydelve:polydelve@127.0.0.1:5432/polydelve_dev
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# DB_POOL_TIMEOUT=10   # seconds a request waits for a free connection

# Auth0 (API audience + tenant domain)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.polydelve.local

# HS256 key for guest browse tokens; random per process if unset.
# GUEST_JWT_SECRET=   # openssl rand -hex 32
# GUEST_JWT_TTL=604800

# ETL / LLM providers
OPENAI_API_KEY=
EXA_API_KEY=
# GCP service accounts: set the JSON inline, or drop files at
# backend/secrets/gcp-sa.json and backend/secrets/polydelve-bq-sa.json
# GCP_SA_JSON=
# GCP_PROJECT_ID=      # defaults to the service account's project
# BQ_SA_JSON=

# Avatars (S3)
# AVATARS_BUCKET=
# AVATARS_REGION=us-east-1

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=polydelve-backend
